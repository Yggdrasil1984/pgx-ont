// Publish DeepVariant's per-chunk gVCFs for pgx (PharmCAT needs explicit
// reference genotypes). Run-specific; nallo itself is not modified.
process {
    withName: '.*:CALL_SNVS:DEEPVARIANT_RUNDEEPVARIANT' {
        publishDir = [
            path:    { "${params.outdir}/snvs/sample/${meta.id}/gvcf_chunks" },
            mode:    'copy',
            pattern: '*.g.vcf.gz*',
        ]
    }
}
